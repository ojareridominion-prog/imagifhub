{
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python"
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/api/telegram-webhook", "destination": "/main.py" },
    { "source": "/api/set-webhook", "destination": "/main.py" },
    { "source": "/api/create-invoice", "destination": "/main.py" },
    { "source": "/api/get-payment-link", "destination": "/main.py" },
    { "source": "/media", "destination": "/main.py" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
